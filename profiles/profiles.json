{
  "schema": 1,
  "_comment": "Class order everywhere: [normal, fg, media, bg]. Values are UNTUNED priors; tune per device with tools/ and record results in memory/workload-profiles.md. perf: 0 = leave cpufreq alone, else 1..1024 hint.",
  "workloads": {
    "idle":     null,
    "ui":       {"slice_us": [4000, 3000, 3000, 8000],  "credit_us": [2000, 8000, 6000, 0],  "charge_pct": [100, 70, 60, 160], "perf": [0, 768, 640, 192]},
    "browser":  {"slice_us": [4000, 4000, 3000, 8000],  "credit_us": [2000, 5000, 6000, 0],  "charge_pct": [100, 75, 60, 170], "perf": [0, 768, 640, 192]},
    "gaming":   {"slice_us": [3000, 2000, 2000, 8000],  "credit_us": [2000, 6000, 6000, 0],  "charge_pct": [100, 60, 60, 180], "perf": [0, 1024, 768, 256]},
    "video":    {"slice_us": [4000, 4000, 3000, 10000], "credit_us": [2000, 4000, 4000, 0],  "charge_pct": [100, 80, 60, 200], "perf": [0, 512, 512, 128]},
    "camera":   {"slice_us": [3000, 3000, 1500, 10000], "credit_us": [2000, 4000, 8000, 0],  "charge_pct": [100, 80, 50, 200], "perf": [0, 768, 896, 128]},
    "graphics": {"slice_us": [4000, 4000, 3000, 10000], "credit_us": [2000, 5000, 5000, 0],  "charge_pct": [100, 70, 60, 180], "perf": [0, 1024, 768, 192]},
    "agentic":  {"slice_us": [8000, 3000, 3000, 10000], "credit_us": [1000, 4000, 4000, 0],  "charge_pct": [100, 80, 70, 120], "perf": [1024, 768, 640, 768]},
    "batch":    {"slice_us": [15000, 8000, 5000, 15000],"credit_us": [0, 2000, 2000, 0],     "charge_pct": [100, 100, 80, 100], "perf": [1024, 1024, 768, 1024]}
  },
  "platforms": {
    "laptop": {
      "timeout_ms": 5000, "canary": true, "canary_s": 3, "approved_only": false, "allow_device_generation": true,
      "states": {
        "ac":          {"perf_cap": 1024, "slice_scale": 1.0},
        "battery":     {"perf_cap": 640,  "slice_scale": 1.5},
        "low_battery": {"perf_cap": 384,  "slice_scale": 2.0},
        "thermal":     {"perf_cap": 512,  "slice_scale": 1.5, "limit_c": 90}
      }
    },
    "mobile": {
      "timeout_ms": 3000, "canary": true, "canary_s": 2, "approved_only": false, "allow_device_generation": true,
      "states": {
        "ac":          {"perf_cap": 896, "slice_scale": 1.0},
        "battery":     {"perf_cap": 640, "slice_scale": 1.25},
        "low_battery": {"perf_cap": 320, "slice_scale": 2.0},
        "thermal":     {"perf_cap": 448, "slice_scale": 1.5, "limit_c": 80}
      }
    },
    "iot": {
      "timeout_ms": 8000, "canary": false, "canary_s": 0, "approved_only": true, "allow_device_generation": false,
      "states": {
        "ac":          {"perf_cap": 512, "slice_scale": 2.0},
        "battery":     {"perf_cap": 384, "slice_scale": 3.0},
        "low_battery": {"perf_cap": 256, "slice_scale": 4.0},
        "thermal":     {"perf_cap": 256, "slice_scale": 3.0, "limit_c": 85}
      }
    },
    "automotive": {
      "timeout_ms": 1000, "canary": true, "canary_s": 3, "approved_only": true, "allow_device_generation": false,
      "allowed_workloads": ["ui", "video", "camera", "graphics"],
      "states": {
        "ac":          {"perf_cap": 1024, "slice_scale": 1.0},
        "battery":     {"perf_cap": 640,  "slice_scale": 1.5},
        "low_battery": {"perf_cap": 384,  "slice_scale": 2.0},
        "thermal":     {"perf_cap": 512,  "slice_scale": 1.5, "limit_c": 95}
      }
    },
    "vm": {
      "timeout_ms": 2000, "canary": true, "canary_s": 2, "approved_only": false, "allow_device_generation": true,
      "states": {
        "ac":          {"perf_cap": 1024, "slice_scale": 1.0},
        "battery":     {"perf_cap": 640,  "slice_scale": 1.5},
        "low_battery": {"perf_cap": 384,  "slice_scale": 2.0},
        "thermal":     {"perf_cap": 512,  "slice_scale": 1.5, "limit_c": 90}
      }
    }
  },
  "slo": {
    "psi_regress_abs": 25.0, "psi_floor": 40.0, "psi_breach_ticks": 10,
    "lat_bad_bucket": 13, "lat_bad_frac": 0.05, "lat_min_samples": 200, "lat_breach_checks": 3,
    "quarantine_s": 300
  },
  "canary_p99_us": 50000
}
